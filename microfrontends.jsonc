{
  "$schema": "https://openapi.vercel.sh/microfrontends.json",
  "options": {
    "disableOverrides": true,
  },
  "applications": {
    "saas-dashboard-ui": {
      "packageName": "@supertokens/saas-dashboard-ui",
      "development": {
        "local": 3000,
        "fallback": "supertokens.com",
      },
    },
    "docs": {
      "packageName": "@supertokens/docs",
      "assetPrefix": "docs-assets",
      "routing": [
        {
          "group": "docs",
          "paths": ["/docs/:path*"],
        },
        {
          "group": "docs-assets",
          "paths": ["/docs-assets/:path*"],
        },
      ],
    },
  },
}
