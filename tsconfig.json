{
  "compilerOptions": {
    "allowJs": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2023",
    "types": ["node"]
  },
  "include": [
    "blume.config.ts",
    "components.ts",
    "components/**/*.tsx",
    "islands/**/*.tsx",
    "lib/**/*.ts",
    "scripts/blume/**/*.ts"
  ],
  "exclude": [".blume", "build", "dist", "node_modules", "src"]
}
