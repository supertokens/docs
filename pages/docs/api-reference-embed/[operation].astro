---
import specs from "blume:openapi";
import Operation from "blume/components/openapi/Operation.astro";
import "blume:theme";

import { apiReferenceOperationIds } from "../../../lib/api-reference-operations";

interface Props {
  operationKey: string;
  title: string;
}

export function getStaticPaths() {
  const spec = specs["references-cdi"];
  if (!spec) {
    throw new Error('[api-reference-embed] OpenAPI source "references-cdi" was not found.');
  }

  return apiReferenceOperationIds.map((operationId) => {
    const operation = Object.values(spec.operations).find((candidate) => candidate.operationId === operationId);
    if (!operation) {
      throw new Error(`[api-reference-embed] Operation "${operationId}" was not found in "references-cdi".`);
    }

    return {
      params: { operation: operation.key },
      props: { operationKey: operation.key, title: operation.summary },
    };
  });
}

const { operationKey, title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="noindex, nofollow" name="robots" />
    <title>{title} API reference</title>
    <script is:inline>
      const applyTheme = () => {
        let theme;
        try {
          theme = window.parent.document.documentElement.dataset.theme;
        } catch {}
        theme ||= localStorage.getItem("blume-theme") || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      };

      applyTheme();
      try {
        if (window.parent !== window) {
          new MutationObserver(applyTheme).observe(window.parent.document.documentElement, {
            attributeFilter: ["data-theme"],
          });
        }
      } catch {}
    </script>
  </head>
  <body class="m-0 bg-background font-sans text-foreground antialiased">
    <main class="min-h-dvh p-4 sm:p-6">
      <Operation id={operationKey} source="references-cdi" />
    </main>
  </body>
</html>
