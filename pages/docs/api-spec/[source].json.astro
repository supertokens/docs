---
import specs from "blume:openapi";

interface Props {
  document: unknown;
}

export const prerender = true;

export function getStaticPaths() {
  const sources = {
    cdi: "references-cdi",
    fdi: "references-fdi",
  } as const;

  return Object.entries(sources).map(([route, source]) => {
    const spec = specs[source];
    if (!spec) throw new Error(`[api-spec] OpenAPI source "${source}" was not found.`);

    return {
      params: { source: route },
      props: { document: spec.document },
    };
  });
}

const { document } = Astro.props;
const body = `${JSON.stringify(document, null, 2)}\n`;
return new Response(body, {
  headers: { "Content-Type": "application/json; charset=utf-8" },
});
---
