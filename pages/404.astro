---
import RootLayout from "blume/components/layout/RootLayout.astro";
import data from "blume:data";

import Header from "../components/Header.astro";

export const prerender = true;

const reportUrl = new URL("https://github.com/supertokens/docs/issues/new");
reportUrl.searchParams.set("title", "Broken documentation link");
reportUrl.searchParams.set("body", "Broken URL: ");
const docsHome = data.config.basePath || "/";
const quickstart = `${data.config.basePath}/quickstart`;
---

<RootLayout
  site={{ title: data.config.title, description: data.config.description }}
  logo={data.config.logo}
  favicon={data.config.favicon}
  appleIcon={data.config.appleIcon}
  banner={data.config.banner}
  navigation={data.navigation}
  page={{ title: "Page not found", route: "/404" }}
  headings={[]}
  themeMode={data.config.theme.mode}
  fontCssVars={data.fontCssVars}
  searchEnabled={data.config.search.enabled}
  ui={data.ui}
  contentLayout="bare"
  layout={{ Header }}
  indexable={false}
  noindex={true}
>
  <section class="mx-auto flex min-h-[65vh] max-w-3xl flex-col justify-center px-5 py-16 sm:px-8 sm:py-24">
    <p class="font-mono text-sm font-semibold uppercase tracking-[0.2em] text-accent">Error 404</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-foreground sm:text-5xl">Page not found</h1>
    <p class="mt-5 max-w-xl text-base leading-7 text-muted-foreground sm:text-lg">
      The page may have moved, or the link may be outdated. Search the docs or continue from a known starting point.
    </p>

    <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
      {
        data.config.search.enabled && (
          <button
            class="inline-flex min-h-11 items-center justify-center rounded-md bg-accent px-5 py-2.5 font-semibold text-accent-foreground transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
            data-not-found-search
            type="button"
          >
            Search docs
          </button>
        )
      }
      <a
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-5 py-2.5 font-semibold text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        href={docsHome}>Docs home</a
      >
      <a
        class="inline-flex min-h-11 items-center justify-center rounded-md border border-border px-5 py-2.5 font-semibold text-foreground hover:bg-muted focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
        href={quickstart}>Quickstart</a
      >
    </div>

    <p class="mt-8 text-sm text-muted-foreground">
      Followed a link from our docs?
      <a
        class="font-medium text-accent underline underline-offset-4"
        data-broken-link-report
        href={reportUrl.toString()}>Report the broken link</a
      >.
    </p>
  </section>
</RootLayout>

<script>
  const searchButton = document.querySelector<HTMLButtonElement>("[data-not-found-search]");
  searchButton?.addEventListener("click", () => {
    document.querySelector<HTMLButtonElement>("[data-blume-search-open]")?.click();
  });

  const reportLink = document.querySelector<HTMLAnchorElement>("[data-broken-link-report]");
  if (reportLink) {
    const url = new URL(reportLink.href);
    let body = `Broken URL: ${window.location.pathname}`;
    if (document.referrer) {
      const referrer = new URL(document.referrer);
      if (referrer.origin === window.location.origin) body += `\nReferrer: ${referrer.pathname}`;
    }
    url.searchParams.set("body", body);
    reportLink.href = url.toString();
  }
</script>
