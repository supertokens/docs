---
import type { ComponentProps } from "astro/types";
import BlumeTableOfContents from "blume/components/layout/TableOfContents.astro";

import DocsPreferences from "./DocsPreferences.astro";

type Props = ComponentProps<typeof BlumeTableOfContents>;

const props = Astro.props as Props;
---

{props.variant === "desktop" && <DocsPreferences />}
<BlumeTableOfContents {...props} />
