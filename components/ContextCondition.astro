---
import VariantContent from "./VariantContent.astro";

interface Props {
  condition: Record<string, string>;
}

const { condition } = Astro.props;
const [propertyName, value] = Object.entries(condition)[0] || [];
const storageKeys: Record<string, string> = {
  "recipes.passwordless.contactMethod": "passwordless-contact-method",
  "recipes.passwordless.flowType": "passwordless-flow-type",
};
const storageKey = storageKeys[propertyName] || propertyName;
---

<VariantContent storageKey={storageKey} value={value}>
  <slot />
</VariantContent>
