---
import VariantSwitch from "./VariantSwitch.astro";
---

<VariantSwitch
  storageKey="ui-type"
  label="UI type"
  defaultValue="prebuilt"
  options={[
    {
      description: "Drop-in components that handle the flows for you.",
      icon: "layout-template",
      label: "Pre-built UI",
      value: "prebuilt",
    },
    {
      description: "Build your own UI and call the SDK directly.",
      icon: "code-2",
      label: "Custom UI",
      value: "custom",
    },
  ]}
/>
