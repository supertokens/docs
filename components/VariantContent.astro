---
interface Props {
  storageKey: string;
  value: string;
}

const { storageKey, value } = Astro.props;
const defaults: Record<string, string> = {
  "ui-type": "prebuilt",
  "tenant-type": "single",
  "nextjs-router-type": "app-router",
  "passwordless-contact-method": "EMAIL",
  "passwordless-flow-type": "MAGIC_LINK",
};
---

<div data-variant-content={storageKey} data-variant-value={value} hidden={value !== defaults[storageKey]}>
  <slot />
</div>

<script>
  import {
    ensureQuery,
    initializeSelectionUrlState,
    isSelectionContextVisible,
    readCanonicalQuery,
    readStorage,
    resolveSelection,
    selectionUrlStateEvent,
    variantStorageKey,
    writeStorage,
  } from "../lib/docs-selection";

  const defaults: Record<string, string> = {
    "ui-type": "prebuilt",
    "tenant-type": "single",
    "nextjs-router-type": "app-router",
    "passwordless-contact-method": "EMAIL",
    "passwordless-flow-type": "MAGIC_LINK",
  };

  const applyVariant = (key: string, value?: string) => {
    const elements = [...document.querySelectorAll<HTMLElement>(`[data-variant-content="${key}"]`)];
    const values = elements.map((element) => element.dataset.variantValue).filter((item): item is string => Boolean(item));
    const storageKey = variantStorageKey(key);
    const selected = resolveSelection({
      availableValues: values,
      defaultValue: defaults[key],
      queryValue: value ? undefined : readCanonicalQuery(key, values),
      storedValue: value || readStorage(storageKey),
    });
    if (!selected) return;
    const hasVisibleContext = elements.some(
      (element) => element.parentElement && isSelectionContextVisible(element.parentElement),
    );
    if (hasVisibleContext) ensureQuery(key, selected);
    if (hasVisibleContext && !value && readCanonicalQuery(key, values) === selected) writeStorage(storageKey, selected);
    for (const element of elements) {
      element.hidden = element.dataset.variantValue !== selected;
    }
    window.dispatchEvent(new CustomEvent("supertokens-docs:variant-content-updated", { detail: { key, value: selected } }));
  };

  const initializeVariantContent = () => {
    const keys = new Set(
      [...document.querySelectorAll<HTMLElement>("[data-variant-content]")]
        .map((element) => element.dataset.variantContent)
        .filter((key): key is string => Boolean(key)),
    );
    for (const key of keys) applyVariant(key);
  };

  initializeVariantContent();
  initializeSelectionUrlState();
  document.addEventListener("astro:page-load", initializeVariantContent);
  window.addEventListener("supertokens-docs:variant", (event) => {
    const detail = (event as CustomEvent<{ key: string; value: string }>).detail;
    if (!detail) return;
    applyVariant(detail.key, detail.value);
    queueMicrotask(initializeVariantContent);
  });
  window.addEventListener(selectionUrlStateEvent, initializeVariantContent);
</script>
