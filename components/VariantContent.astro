---
interface Props {
  storageKey: string;
  value: string;
}

const { storageKey, value } = Astro.props;
---

<div data-variant-content={storageKey} data-variant-value={value}>
  <slot />
</div>

<script>
  const defaults: Record<string, string> = {
    "ui-type": "prebuilt",
    "tenant-type": "single",
    "nextjs-router-type": "app-router",
    "passwordless-contact-method": "EMAIL",
    "passwordless-flow-type": "MAGIC_LINK",
  };

  const applyVariant = (key: string, value?: string) => {
    const selected = value || localStorage.getItem(`supertokens-docs:${key}`) || defaults[key];
    for (const element of document.querySelectorAll<HTMLElement>(`[data-variant-content="${key}"]`)) {
      element.hidden = element.dataset.variantValue !== selected;
    }
  };

  const initializeVariantContent = () => {
    const keys = new Set(
      [...document.querySelectorAll<HTMLElement>("[data-variant-content]")]
        .map((element) => element.dataset.variantContent)
        .filter((key): key is string => Boolean(key)),
    );
    for (const key of keys) applyVariant(key);
  };

  initializeVariantContent();
  document.addEventListener("astro:page-load", initializeVariantContent);
  window.addEventListener("supertokens-docs:variant", (event) => {
    const detail = (event as CustomEvent<{ key: string; value: string }>).detail;
    if (detail) applyVariant(detail.key, detail.value);
  });
</script>
