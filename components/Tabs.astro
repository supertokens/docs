---
import type { TabsProps } from "blume/components";

import SelectionGroup from "./SelectionGroup.astro";
import type { TabGroup } from "./tab-groups";

interface Props extends TabsProps {
  group?: TabGroup;
  passive?: boolean;
}

const { hash = false, sync = false, ...props } = Astro.props as Props;
---

<SelectionGroup kind="tabs" hash={hash} sync={sync} {...props}>
  <slot />
</SelectionGroup>
