---
import { withBase } from "blume/components/islands/base-path.ts";

interface Props {
  managedOnly?: boolean;
}

const { managedOnly = false } = Astro.props;
const licenseKeyGuide = withBase("/deployment/self-host-supertokens#5-add-license-keys");
---

<paid-feature-callout class="st-paid-feature not-prose">
  <aside aria-label="Paid feature" class="st-paid-feature-callout">
    <svg
      aria-hidden="true"
      class="st-paid-feature-card-icon"
      fill="none"
      height="24"
      viewBox="0 0 24 24"
      width="24"
    >
      <rect height="16" rx="2" stroke="currentColor" stroke-width="1.75" width="22" x="1" y="4"></rect>
      <path d="M1 10h22" stroke="currentColor" stroke-width="1.75"></path>
    </svg>
    <p>This feature is only available to paid users.</p>
    <button
      aria-expanded="false"
      aria-haspopup="dialog"
      class="st-paid-feature-details"
      data-paid-feature-trigger
      type="button"
    >
      View Details
    </button>
  </aside>

  <dialog aria-label="Enable paid features" class="st-paid-feature-drawer" data-paid-feature-dialog>
    <div class="st-paid-feature-drawer-layout">
      <header class="st-paid-feature-drawer-header">
        <h2>Enable paid features</h2>
        <button
          aria-label="Close paid feature details"
          class="st-paid-feature-icon-button"
          data-paid-feature-close
          type="button"
        >
          <svg aria-hidden="true" fill="none" height="20" viewBox="0 0 24 24" width="20">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-linecap="round" stroke-width="2"></path>
          </svg>
        </button>
      </header>

      <div class="st-paid-feature-drawer-body">
        <p>This feature is only available to paid users. Follow the instructions below to enable it.</p>

        <aside aria-label="Development environment availability" class="st-paid-feature-development-note">
          <svg aria-hidden="true" fill="none" height="20" viewBox="0 0 24 24" width="20">
            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.75"></circle>
            <path d="M12 11v6M12 7.5v.5" stroke="currentColor" stroke-linecap="round" stroke-width="1.75"></path>
          </svg>
          <p>
            You can test paid features for free in development core instances. You are only charged when you use them in
            production.
          </p>
        </aside>

        {
          managedOnly && (
            <p class="st-paid-feature-managed-only">
              This feature is available only with the SuperTokens Managed Service.
            </p>
          )
        }

        <section>
          <h3>Managed Service</h3>
          <ol class="st-paid-feature-steps">
            <li>
              <span>Sign in to the <a href="https://supertokens.com/dashboard">SuperTokens dashboard</a>.</span>
            </li>
            <li>
              <span>Select the <strong>managed service</strong> option from the <i>service type</i> select component.</span>
            </li>
            <li>
              <span>Select your <strong>core instance</strong> from the next elemenet or create a new one. </span>
            </li>
            <li>
              <span>Open <strong>Features</strong> sub-page and enable the required ones.</span>
            </li>
          </ol>
        </section>

        {
          !managedOnly && (
            <section>
              <h3>Self Hosted</h3>
              <ol class="st-paid-feature-steps">
                <li>
                  <span>Sign in to the <a href="https://supertokens.com/dashboard">SuperTokens dashboard</a>.</span>
                </li>
                <li>
                  <span>Select the <strong>self-hosted</strong> option from the <i>service type</i> select component.</span>
                </li>
                <li>
                  <span>Select your <strong>license key</strong> from the next elemenet or create a new one. Then enable the required features.</span>
                </li>
                <li>
                  <span>
                    If the key is not yet configured, <a href={licenseKeyGuide}>add it to your Core service</a>. If your
                    Core already uses this key, no configuration changes are required.
                  </span>
                </li>
              </ol>
            </section>
          )
        }
      </div>

      <footer class="st-paid-feature-drawer-footer">
        <button class="st-paid-feature-close" data-paid-feature-close type="button">Close</button>
      </footer>
    </div>
  </dialog>
</paid-feature-callout>

<script>
  class PaidFeatureCallout extends HTMLElement {
    connectedCallback() {
      if (this.hasAttribute("data-paid-feature-ready")) return;
      this.setAttribute("data-paid-feature-ready", "");

      const trigger = this.querySelector<HTMLButtonElement>("[data-paid-feature-trigger]");
      const dialog = this.querySelector<HTMLDialogElement>("[data-paid-feature-dialog]");
      const closeButtons = this.querySelectorAll<HTMLButtonElement>("[data-paid-feature-close]");
      if (!trigger || !dialog) return;

      trigger.addEventListener("click", () => {
        trigger.setAttribute("aria-expanded", "true");
        dialog.showModal();
        closeButtons.item(0)?.focus();
      });

      for (const button of closeButtons) button.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      dialog.addEventListener("close", () => {
        trigger.setAttribute("aria-expanded", "false");
        if (trigger.isConnected) trigger.focus();
      });
    }
  }

  if (!customElements.get("paid-feature-callout")) customElements.define("paid-feature-callout", PaidFeatureCallout);
</script>
