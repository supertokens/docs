---
interface Option {
  label: string;
  value: string;
}

interface Props {
  storageKey: string;
  options: Option[];
  defaultValue: string;
  label: string;
}

const { storageKey, options, defaultValue, label } = Astro.props;
---

<label class="variant-switch">
  <span>{label}</span>
  <select data-variant-switch={storageKey} data-default-value={defaultValue}>
    {options.map((option) => <option value={option.value}>{option.label}</option>)}
  </select>
</label>

<script>
  const initializeVariantSwitches = () => {
    for (const select of document.querySelectorAll<HTMLSelectElement>("select[data-variant-switch]")) {
      if (select.dataset.initialized) continue;
      select.dataset.initialized = "true";
      const key = select.dataset.variantSwitch;
      if (!key) continue;
      select.value = localStorage.getItem(`supertokens-docs:${key}`) || select.dataset.defaultValue || select.value;
      select.addEventListener("change", () => {
        localStorage.setItem(`supertokens-docs:${key}`, select.value);
        window.dispatchEvent(new CustomEvent("supertokens-docs:variant", { detail: { key, value: select.value } }));
      });
    }
  };

  initializeVariantSwitches();
  document.addEventListener("astro:page-load", initializeVariantSwitches);
</script>

<style>
  .variant-switch {
    align-items: center;
    display: flex;
    gap: 0.75rem;
    margin-block: 1rem;
  }

  .variant-switch span {
    font-weight: 600;
  }

  .variant-switch select {
    background: var(--background);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    color: inherit;
    padding: 0.45rem 2rem 0.45rem 0.65rem;
  }
</style>
