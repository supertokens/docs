---
import VariantContent from "./VariantContent.astro";

interface Props {
  propertyName: string;
  condition: string;
}

const { propertyName, condition } = Astro.props;
const storageKey = propertyName === "nextjsRouterType" ? "nextjs-router-type" : propertyName;
---

<VariantContent storageKey={storageKey} value={condition}>
  <slot />
</VariantContent>
