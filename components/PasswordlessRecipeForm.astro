---
import VariantSwitch from "./VariantSwitch.astro";
---

<div class="passwordless-options">
  <VariantSwitch
    storageKey="passwordless-contact-method"
    label="Contact method"
    defaultValue="EMAIL"
    options={[
      { label: "Email", value: "EMAIL" },
      { label: "Phone", value: "PHONE" },
      { label: "Email or phone", value: "EMAIL_OR_PHONE" },
    ]}
  />
  <VariantSwitch
    storageKey="passwordless-flow-type"
    label="Flow type"
    defaultValue="MAGIC_LINK"
    options={[
      { label: "Magic link", value: "MAGIC_LINK" },
      { label: "One-time code", value: "USER_INPUT_CODE" },
      { label: "Code and magic link", value: "USER_INPUT_CODE_AND_MAGIC_LINK" },
    ]}
  />
</div>

<style>
  .passwordless-options {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
